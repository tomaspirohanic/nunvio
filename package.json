    "@stripe/stripe-js": "^8.6.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "countries-list": "^3.2.2",
    "embla-carousel-react": "^8.6.0",
