# ============================================
# NUNVIO — ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================
# Copy to `.env` for local use. For production, set the SAME keys on Vercel
# with production URLs (see docs/PRODUCTION-LAUNCH.md).
# ============================================

# --------------------------------------------
# Database (PostgreSQL — e.g. Neon)
# --------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --------------------------------------------
# NextAuth + public URL
# --------------------------------------------
# Local:
# NEXTAUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (FINAL — use these on Vercel Production):
NEXTAUTH_URL="https://nunvio.eu"
NEXT_PUBLIC_APP_URL="https://nunvio.eu"
NEXTAUTH_SECRET="replace-with-a-32-byte-random-hex-string"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------
# Email (Resend SMTP)
# --------------------------------------------
EMAIL_HOST="smtp.resend.com"
EMAIL_PORT="587"
EMAIL_USER="resend"
EMAIL_PASS="re_xxxxxxxx"
# After verifying nunvio.eu in Resend:
EMAIL_FROM="Nunvio <noreply@nunvio.eu>"

# --------------------------------------------
# Stripe
# --------------------------------------------
STRIPE_SECRET_KEY="sk_live_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --------------------------------------------
# Cron + partners
# --------------------------------------------
CRON_SECRET="replace-with-a-long-random-string"
PARTNER_CONTACT_EMAIL="tomas.pirohanic@gmail.com"

# --------------------------------------------
# Cloudflare R2
# --------------------------------------------
S3_REGION="auto"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-r2-secret-access-key"
S3_BUCKET_NAME="nunvio-images"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="https://pub-<HASH>.r2.dev"
# Optional later: https://images.nunvio.eu

# Optional
# DEEPL_API_KEY="your-deepl-api-key"
